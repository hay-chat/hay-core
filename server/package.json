{
  "name": "@hay/server",
  "version": "0.1.0",
  "private": true,
  "main": "main.ts",
  "scripts": {
    "dev": "nodemon main.ts",
    "dev:clean": "nodemon main.ts",
    "build": "npm run build:plugins && tsc && tsc-alias && npm run copy:templates",
    "copy:templates": "cp -r templates dist/ && cp -r i18n dist/ && cp -r assets dist/",
    "build:plugins": "cd .. && ./scripts/build-plugins.sh",
    "start": "node dist/main.js",
    "kill-ports": "lsof -ti tcp:3000,4000,5000 | xargs kill -9 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=services",
    "test:integration": "jest --testPathPattern=routes",
    "test:scheduler": "jest scheduler.service.test.ts",
    "test:privacy": "jest privacy.test.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ./database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ./database/data-source.ts",
    "migration:ensure": "./scripts/check-migrations.sh",
    "migration:check": "tsx scripts/ensure-migrations.ts",
    "order-links:backfill": "tsx scripts/backfill-order-links.ts",
    "insights:backfill-feedback": "tsx scripts/backfill-feedback-insights.ts",
    "plugins:enable-defaults": "tsx scripts/enable-default-plugins.ts",
    "dev:account": "tsx scripts/create-dev-account.ts",
    "documents:privatize-images": "tsx scripts/privatize-document-images.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/lib-storage": "^3.1163.0",
    "@google/genai": "^2.32.0",
    "@hay/form-schema": "*",
    "@mozilla/readability": "^0.6.0",
    "@puppeteer/browsers": "^3.2.6",
    "@trpc/server": "^11.22.1",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "amqplib": "^0.10.9",
    "archiver": "^7.0.1",
    "argon2": "^0.45.2",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "file-type": "^16.5.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.1",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "linkedom": "0.18.15",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.2",
    "mjml": "^4.16.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "posthog-node": "^5.63.0",
    "puppeteer-core": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "typeorm": "^0.3.31",
    "typescript": "^5.3.3",
    "undici": "^7.18.2",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "word-extractor": "^1.0.4",
    "ws": "^8.14.2",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/amqplib": "^0.10.8",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.9.10"
  }
}
