{
  "name": "@hay/server",
  "version": "0.1.0",
  "private": true,
  "main": "main.ts",
  "scripts": {
    "dev": "NODE_ENV=development nodemon main.ts",
    "dev:clean": "NODE_ENV=development nodemon main.ts",
    "build": "npm run build:plugins && tsc && tsc-alias && npm run copy:templates",
    "copy:templates": "cp -r templates dist/ && cp -r i18n dist/ && cp -r assets dist/",
    "build:plugins": "cd .. && ./scripts/build-plugins.sh",
    "start": "node dist/main.js",
    "kill-ports": "lsof -ti tcp:3000,4000,5000 | xargs kill -9 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=services",
    "test:integration": "jest --testPathPattern=routes",
    "test:scheduler": "jest scheduler.service.test.ts",
    "test:privacy": "jest privacy.test.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ./database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ./database/data-source.ts",
    "migration:ensure": "./scripts/check-migrations.sh",
    "migration:check": "tsx scripts/ensure-migrations.ts",
    "order-links:backfill": "tsx scripts/backfill-order-links.ts",
    "insights:backfill-feedback": "tsx scripts/backfill-feedback-insights.ts",
    "plugins:enable-defaults": "tsx scripts/enable-default-plugins.ts",
    "dev:account": "tsx scripts/create-dev-account.ts",
    "docs:seed": "NODE_ENV=development tsx scripts/seed-docs-screenshots.ts",
    "documents:privatize-images": "tsx scripts/privatize-document-images.ts",
    "privacy:replay-erasures": "tsx scripts/replay-erasures.ts",
    "audit:sink": "tsx scripts/audit-sink.ts",
    "db:provision-app-role": "tsx scripts/provision-app-role.ts",
    "secrets:rotate-encryption-key": "tsx scripts/rotate-plugin-encryption-key.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@google/genai": "^3.6.1",
    "@hay/form-schema": "*",
    "@mozilla/readability": "^0.6.0",
    "@node-saml/node-saml": "^5.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@puppeteer/browsers": "^3.2.7",
    "@simplewebauthn/server": "^14.1.0",
    "@trpc/server": "^11.29.7",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "amqplib": "^2.4.1",
    "archiver": "^8.0.0",
    "argon2": "^0.45.2",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "linkedom": "0.18.15",
    "mammoth": "^1.13.0",
    "marked": "^17.0.1",
    "mime-types": "^3.0.2",
    "mjml": "^5.4.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "openai": "^7.62.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "posthog-node": "^6.0.6",
    "puppeteer-core": "^25.17.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "tar": "^7.5.23",
    "tsconfig-paths": "^4.2.0",
    "turndown": "^7.2.5",
    "typeorm": "^1.1.3",
    "undici": "^7.18.2",
    "uuid": "^14.0.3",
    "web-push": "^4.0.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.23.0",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/mjml": "^5.4.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@types/xml2js": "^0.4.14",
    "@xmldom/xmldom": "^0.9.12",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "xml-crypto": "^6.4.0"
  }
}
