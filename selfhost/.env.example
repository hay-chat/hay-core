# Self-hosted Hay configuration. Copy to selfhost/.env and fill in the
# REQUIRED block. Everything else is optional. See ../SELF_HOSTING.md.
#
# Generate each secret with:  openssl rand -hex 32

# ---------------------------------------------------------------- REQUIRED --

# The domain Hay is served on (dashboard, API and widget all live here).
# Its DNS A/AAAA record must point at this machine before first start.
HAY_DOMAIN=support.example.com

# Database, cache and queue passwords (used by the bundled containers).
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# Session signing keys: at least 32 characters, and different from each other.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encrypts plugin credentials stored in the database. Back it up: if you lose
# it, every connected integration has to be reconnected.
PLUGIN_ENCRYPTION_KEY=

# OpenAI key. Used for embeddings (knowledge base search) and, unless you set
# LLM_* below or a provider per organization, for chat as well.
OPENAI_API_KEY=

# ------------------------------------------------------------- RECOMMENDED --

# Email for signup verification, password resets and invites.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=
SMTP_AUTH_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Hay

# With SMTP off, nobody could confirm their email, so new signups are marked
# verified straight away. Set to true once SMTP works.
REQUIRE_EMAIL_VERIFICATION=false

# Public signup. Register your own account first, then set this to false so
# only people you invite can join this instance.
ALLOW_SIGNUP=true

# Let organizations enter their own OAuth apps / API keys for integrations
# whose one-click setup relies on Hay.chat's hosted apps (Shopify, Meta, ...).
PLUGIN_ALLOW_MANAGED_OVERRIDE=true

LOG_LEVEL=info

# ---------------------------------------------------------------- OPTIONAL --

# Reverse-proxy hops in front of the server (default 1: the bundled Caddy). If
# another proxy or CDN sits in front of Caddy, count it too, otherwise client IPs
# in rate limits and audit logs are wrong. See ../SELF_HOSTING.md.
# TRUST_PROXY=1

# Database name and user (defaults: hay / hay).
# DB_USERNAME=hay
# Password of hay_app, the role the application connects as. Set it: left empty it
# defaults to DB_PASSWORD, and the application then holds the owner role's password too.
# DB_APP_PASSWORD=
# DB_NAME=hay

# Another OpenAI-compatible host for default chat calls (embeddings stay on
# OPENAI_API_KEY). LLM_VENDOR: openai | custom-tools | custom
# LLM_BASE_URL=
# LLM_VENDOR=
# LLM_API_KEY=

# Web Push alerts for agents. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Cloudflare Turnstile bot check on the chat widget.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# S3-compatible storage for uploads. Unset = local disk (the "uploads" volume).
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Virus scan of conversation documents through a clamd you run yourself.
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# Product analytics and error reporting. Unset = no telemetry at all.
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
