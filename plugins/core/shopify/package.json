{
  "name": "hay-plugin-shopify",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Shopify store — Hay.chat handles auth (managed OAuth or self-hosted), exposes Admin API tools via MCP, and syncs your catalog so the agent can recommend real products.",
  "homepage": "https://hay.chat/docs/user-guide/integrations/shopify/",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Shopify",
    "category": "integration",
    "marketplaceCategory": "commerce",
    "capabilities": [
      "mcp",
      "auth",
      "cron",
      "products",
      "disputes",
      "privacy"
    ],
    "setup": {
      "businessTypes": [
        "store"
      ],
      "group": "commerce",
      "handles": [
        "orders",
        "refunds",
        "order_changes"
      ]
    },
    "env": [
      "SHOPIFY_OAUTH_CLIENT_ID",
      "SHOPIFY_OAUTH_CLIENT_SECRET"
    ],
    "network": {
      "egress": [
        {
          "fromConfig": "shopDomain",
          "suffix": ".myshopify.com"
        }
      ]
    },
    "oauthHosts": [
      "*.myshopify.com"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
