{
  "name": "hay-plugin-klaviyo",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Klaviyo account to manage profiles, lists, segments, campaigns, flows, events, and templates",
  "homepage": "https://hay.chat/docs/user-guide/integrations/klaviyo/",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Klaviyo",
    "category": "integration",
    "marketplaceCategory": "crm",
    "capabilities": [
      "mcp",
      "auth"
    ],
    "network": {
      "egress": [
        "a.klaviyo.com"
      ]
    },
    "setup": {
      "businessTypes": [
        "store"
      ],
      "group": "marketing"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}
