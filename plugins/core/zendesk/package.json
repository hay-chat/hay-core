{
  "name": "hay-plugin-zendesk",
  "version": "2.0.0",
  "description": "Connect your Zendesk account to manage tickets, customers, and support workflows",
  "homepage": "https://hay.chat/docs/user-guide/integrations/zendesk/",
  "author": "Hay",
  "type": "module",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Zendesk",
    "category": "integration",
    "marketplaceCategory": "crm",
    "capabilities": [
      "mcp",
      "tickets"
    ],
    "setup": {
      "businessTypes": [
        "store",
        "saas",
        "service",
        "other"
      ],
      "group": "helpdesk"
    },
    "env": [
      "ZENDESK_SUBDOMAIN",
      "ZENDESK_EMAIL",
      "ZENDESK_API_TOKEN"
    ],
    "network": {
      "egress": [
        {
          "fromConfig": "subdomain",
          "suffix": ".zendesk.com"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:mcp",
    "build:mcp": "tsc",
    "build:ui": "vite build --config vite.config.ui.ts",
    "start": "node dist/index.js",
    "dev": "npm run build:ui && npm run build:mcp",
    "dev:ui": "vite build --watch --config vite.config.ui.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.3.3",
    "vite": "^6.4.5",
    "vue": "^3.5.45"
  }
}
