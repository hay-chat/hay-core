{
  "name": "hay-channel-email-imap",
  "version": "1.0.0",
  "description": "Connect email as a communication channel via IMAP/SMTP",
  "author": "Hay",
  "type": "module",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Email IMAP",
    "category": "channel",
    "channel": "email",
    "keepAlive": true,
    "capabilities": [
      "messages",
      "customers"
    ],
    "env": []
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk",
    "imapflow": "^1.0.172",
    "mailparser": "^3.7.2",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.3.3"
  }
}
