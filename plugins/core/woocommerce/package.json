{
  "name": "hay-plugin-woocommerce",
  "version": "1.0.0",
  "description": "Connect your WooCommerce store so the agent can find a customer's orders, track shipments, cancel or re-route undispatched orders, issue refunds, and answer product and stock questions",
  "author": "Hay",
  "type": "module",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "WooCommerce",
    "category": "integration",
    "capabilities": [
      "mcp",
      "products"
    ],
    "env": []
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "vite build --config vite.config.ui.ts",
    "start": "node dist/index.js",
    "dev": "npm run build:ui && tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vitest": "^1.6.1",
    "vue": "^3.5.26"
  }
}
