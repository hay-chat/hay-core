{
  "name": "hay-plugin-woocommerce",
  "version": "1.0.0",
  "description": "Connect your WooCommerce store so the agent can find a customer's orders, track shipments, cancel or re-route undispatched orders, issue refunds, and answer product and stock questions",
  "homepage": "https://hay.chat/docs/user-guide/integrations/woocommerce/",
  "author": "Hay",
  "type": "module",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "WooCommerce",
    "category": "integration",
    "marketplaceCategory": "commerce",
    "capabilities": [
      "mcp",
      "products",
      "credentials"
    ],
    "setup": {
      "businessTypes": [
        "store"
      ],
      "group": "commerce",
      "handles": [
        "orders",
        "refunds",
        "order_changes"
      ]
    },
    "env": [],
    "network": {
      "egress": [
        {
          "fromConfig": "siteUrl"
        }
      ]
    },
    "credentials": [
      {
        "name": "consumerKey",
        "source": "config",
        "capability": "mcp",
        "hosts": [
          {
            "fromConfig": "siteUrl"
          }
        ]
      },
      {
        "name": "consumerSecret",
        "source": "config",
        "capability": "mcp",
        "hosts": [
          {
            "fromConfig": "siteUrl"
          }
        ]
      },
      {
        "name": "auth",
        "source": "auth",
        "capability": "mcp",
        "hosts": [
          {
            "fromConfig": "siteUrl"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "vite build --config vite.config.ui.ts",
    "start": "node dist/index.js",
    "dev": "npm run build:ui && tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
