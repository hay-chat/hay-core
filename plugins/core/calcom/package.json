{
  "name": "hay-plugin-calcom",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Cal.com account so the agent can list event types, find open slots, and book, reschedule, or cancel meetings",
  "homepage": "https://hay.chat/docs/user-guide/integrations/calcom/",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Cal.com",
    "category": "integration",
    "marketplaceCategory": "knowledge",
    "capabilities": [
      "mcp",
      "auth"
    ],
    "network": {
      "egress": [
        "api.cal.com"
      ]
    },
    "setup": {
      "businessTypes": [
        "service"
      ],
      "group": "booking",
      "handles": [
        "bookings"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}
