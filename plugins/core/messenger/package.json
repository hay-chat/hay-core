{
  "name": "hay-channel-messenger-meta",
  "version": "1.0.0",
  "description": "Connect Facebook Messenger as a communication channel — exchange Page messages through Hay.chat's AI orchestrator using a shared Hay.chat-owned Meta app (Facebook Login)",
  "author": "Hay",
  "type": "module",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Messenger",
    "category": "channel",
    "channel": "messenger",
    "inactivity": {
      "warningMinutes": 60,
      "closeMinutes": 120
    },
    "rendering": {
      "markdown": "plain",
      "productRecommendations": "text"
    },
    "capabilities": [
      "messages",
      "customers"
    ],
    "env": [
      "META_MESSENGER_APP_ID",
      "META_MESSENGER_APP_SECRET",
      "META_VERIFY_TOKEN"
    ],
    "network": {
      "egress": [
        "graph.facebook.com",
        "*.fbcdn.net",
        "*.fbsbx.com"
      ]
    },
    "oauthHosts": [
      "www.facebook.com",
      "graph.facebook.com"
    ]
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "vite build --config vite.config.ui.ts",
    "start": "node dist/index.js",
    "dev": "npm run build:ui && tsc",
    "dev:ui": "vite build --watch --config vite.config.ui.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.3.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
