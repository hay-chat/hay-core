{
  "name": "hay-plugin-nuvemshop",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Nuvemshop / Tiendanube store so the agent can find a customer's orders, track shipments, cancel or re-route undispatched orders, record refund requests honestly, send unpaid-order payment links, issue capped goodwill coupons, and answer product and stock questions",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Nuvemshop",
    "category": "integration",
    "capabilities": [
      "mcp",
      "auth",
      "products",
      "privacy"
    ],
    "setup": {
      "businessTypes": [
        "store"
      ],
      "group": "commerce",
      "handles": [
        "orders",
        "order_changes"
      ]
    },
    "env": [
      "NUVEMSHOP_OAUTH_CLIENT_ID",
      "NUVEMSHOP_OAUTH_CLIENT_SECRET"
    ],
    "oauthHosts": [
      "www.nuvemshop.com.br",
      "www.tiendanube.com"
    ]
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^5.1.0"
  }
}
