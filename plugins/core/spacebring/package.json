{
  "name": "hay-plugin-spacebring",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Spacebring co-working space so the assistant can book, move and cancel rooms for members, invite their guests, report issues and answer house questions",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Spacebring",
    "category": "integration",
    "capabilities": [
      "mcp",
      "auth"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0",
    "vitest": "^1.6.1"
  }
}
