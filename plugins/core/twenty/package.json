{
  "name": "hay-plugin-twenty",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Twenty CRM workspace to manage people, companies, notes, tasks, and any custom object",
  "homepage": "https://hay.chat/docs/user-guide/integrations/twenty/",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Twenty CRM",
    "category": "integration",
    "marketplaceCategory": "crm",
    "capabilities": [
      "mcp",
      "auth",
      "credentials"
    ],
    "network": {
      "egress": [
        {
          "fromConfig": "baseUrl"
        }
      ]
    },
    "setup": {
      "businessTypes": [
        "saas",
        "service"
      ],
      "group": "crm"
    },
    "credentials": [
      {
        "name": "apiKey",
        "source": "config",
        "capability": "mcp",
        "hosts": [
          {
            "fromConfig": "baseUrl"
          }
        ]
      },
      {
        "name": "auth",
        "source": "auth",
        "capability": "mcp",
        "hosts": [
          {
            "fromConfig": "baseUrl"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6"
  }
}
