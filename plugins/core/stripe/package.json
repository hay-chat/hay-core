{
  "name": "hay-plugin-stripe",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Stripe account to manage payments, customers, subscriptions, and more",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Stripe",
    "category": "integration",
    "capabilities": [
      "mcp",
      "auth",
      "cron",
      "disputes"
    ],
    "network": {
      "egress": [
        "api.stripe.com",
        "files.stripe.com"
      ]
    },
    "setup": {
      "businessTypes": [
        "store",
        "saas",
        "service",
        "other"
      ],
      "group": "payments",
      "handles": [
        "refunds",
        "billing",
        "subscriptions"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^26.6.6"
  }
}
