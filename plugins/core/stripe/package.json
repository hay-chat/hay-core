{
  "name": "hay-plugin-stripe",
  "version": "1.0.0",
  "type": "module",
  "description": "Connect your Stripe account to manage payments, customers, subscriptions, and more",
  "homepage": "https://hay.chat/docs/user-guide/integrations/stripe/",
  "author": "Hay",
  "main": "dist/index.js",
  "hay-plugin": {
    "entry": "./dist/index.js",
    "displayName": "Stripe",
    "category": "integration",
    "marketplaceCategory": "payments",
    "capabilities": [
      "mcp",
      "auth",
      "cron",
      "disputes",
      "credentials"
    ],
    "network": {
      "egress": [
        "api.stripe.com",
        "files.stripe.com"
      ]
    },
    "setup": {
      "businessTypes": [
        "store",
        "saas",
        "service",
        "other"
      ],
      "group": "payments",
      "handles": [
        "refunds",
        "billing",
        "subscriptions"
      ]
    },
    "credentials": [
      {
        "name": "apiKey",
        "source": "config",
        "capability": "mcp",
        "hosts": [
          "api.stripe.com"
        ]
      },
      {
        "name": "auth",
        "source": "auth",
        "capability": "mcp",
        "hosts": [
          "api.stripe.com"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hay/plugin-sdk": "file:../../../packages/plugin-sdk"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6"
  }
}
