# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hay
DB_PASSWORD=hay_password
DB_NAME=hay_db
DB_SSL=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# RabbitMQ Configuration
RABBITMQ_URL=amqp://hay:hay_password@localhost:5672/

# JWT Configuration (REQUIRED - minimum 32 characters)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=

# Web Push alerts (OPTIONAL) - lets dashboard users get a phone/desktop notification
# when a conversation needs a human, even with no tab open. Generate a key pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: URL identifying YOUR deployment to the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Internal API (OPTIONAL) - shared secret for the `internal.*` tRPC procedures,
# sent by an external operator in the `x-hay-internal-secret` header to suspend
# organizations or push access notices. Leave empty to disable (self-hosting default).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
# Optional: core POSTs signed events here (header x-hay-signature: t=<unix>,v1=<HMAC-SHA256
# of "<t>.<body>" keyed with INTERNAL_API_SECRET), e.g. organization.deleted when an owner
# deletes a workspace, so the operator can cancel billing. Leave empty to disable.
OPERATOR_EVENTS_URL=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# --- Default chat provider (optional) -----------------------------------------
# Used for calls with no organizationId, and as the fallback for orgs that have
# not configured their own provider in Settings -> LLM. Leave unset to stay on
# OpenAI with OPENAI_API_KEY above.
#
# Set all three to move every default chat call to another OpenAI-compatible
# host. Example, DigitalOcean Gradient:
#   LLM_BASE_URL=https://inference.do-ai.run/v1
#   LLM_VENDOR=custom-tools
#   LLM_API_KEY=your-digitalocean-model-access-key
#
# LLM_VENDOR selects the structured-output capability profile:
#   openai       strict JSON schema (rung 1)
#   custom-tools forced tool choice (rung 3) — hosts advertising tool calling
#   custom       loose JSON + validate-and-repair (rung 2) — unknown hosts
# LLM_BASE_URL=
# LLM_VENDOR=
# LLM_API_KEY=

# Per-tier model overrides. Apply to the default bundle regardless of provider.
# LLM_TIER_HARD=
# LLM_TIER_MEDIUM=
# LLM_TIER_EASY=

# NOTE: embeddings deliberately ignore LLM_* and stay on OPENAI_API_KEY — the
# pgvector column and HNSW index are pinned to EMBEDDING_DIM.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
# Speech-to-text for inbound voice notes (channel plugins). Uses OPENAI_API_KEY.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Vision pass on customer photos and PDFs (Settings -> Customer Privacy -> "Read
# images"). Uses the EU endpoint (OPENAI_EU_*) when set, else OPENAI_API_KEY.
OPENAI_VISION_MODEL=gpt-4.1-mini

# Base URL for every call made with OPENAI_API_KEY: embeddings, voice-note
# transcription, and default chat when LLM_BASE_URL is unset. Empty means
# api.openai.com. For OpenAI EU data residency use https://eu.api.openai.com/v1
# with a key from the EU project.
# OPENAI_BASE_URL=

# --- EU-only AI processing (optional, per organization) -----------------------
# Organizations that turn on "EU only" in Settings -> AI Models send every chat,
# embedding and transcription call here, never to the default endpoint. The
# switch is only offered when both values are set; if they are removed later,
# AI calls for EU-only orgs fail instead of falling back to another region.
# Needs an OpenAI EU data residency project (approval required by OpenAI).
# OPENAI_EU_BASE_URL=https://eu.api.openai.com/v1
# OPENAI_EU_API_KEY=
# Optional tier models for EU orgs (default: the OpenAI tiers in model-catalog.ts).
# LLM_TIER_* does not apply here: it names models on the default host.
# OPENAI_EU_TIER_HARD=
# OPENAI_EU_TIER_MEDIUM=
# OPENAI_EU_TIER_EASY=

# Embedding Configuration
EMBEDDING_DIM=1536

# Insights engine thresholds (starting values; owners can override min size and
# similarity per organization on the Insights page). Window = clustering days.
# INSIGHTS_MIN_CLUSTER_SIZE=5
# INSIGHTS_JOIN_THRESHOLD=0.86
# INSIGHTS_MERGE_THRESHOLD=0.91
# INSIGHTS_WINDOW_DAYS=30

# File uploads
# Max size (MB) for logos, documents and other dashboard uploads.
# UPLOAD_MAX_SIZE_MB=10
# Max size (MB) for files sent in conversations (channel media, widget and Inbox
# attachments). Plugins send base64 in a 50 MB JSON body, so keep it <= 35.
# CONVERSATION_MEDIA_MAX_SIZE_MB=25
# Virus scan of conversation documents (PDF, TXT, CSV) through clamd. Unset =
# no scan (files are marked "skipped" and shown as before). When set, documents
# are held as "scanning" until clamd answers; infected or failed scans are blocked.
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# Organization Configuration
ORGANIZATION_EXTRACTION_METHOD=subdomain,header,jwt
DEFAULT_ORGANIZATION=default

# Domain Configuration
# These are REQUIRED in production - the server will not start without them
BASE_DOMAIN=localhost
APP_PROTOCOL=http

# Service Domains (REQUIRED in production)
# In development, defaults to localhost. In production, you must set these.
# Examples for production:
#   API_DOMAIN=app.yourdomain.com (if using same-domain routing)
#   API_DOMAIN=api.yourdomain.com (if using separate subdomains)
#   DASHBOARD_DOMAIN=app.yourdomain.com
API_DOMAIN=localhost:3001
DASHBOARD_DOMAIN=localhost:3000
CDN_DOMAIN=
USE_SSL=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
DEBUG=false  # Set to true to enable ALL debug logging (including OpenAI SDK and other Node.js modules)

# Debug Module Filtering (auto-enables debug logging when set to non-"*" value)
# IMPORTANT: Setting DEBUG_MODULES to anything other than "*" will enable debug logging
# for your app WITHOUT setting DEBUG=true, which avoids OpenAI SDK debug logs.
#
# Examples:
# DEBUG_MODULES="*" - Show all modules (requires DEBUG=true to work)
# DEBUG_MODULES="perception,retrieval,execution" - Only show these modules (auto-enables debugging)
# DEBUG_MODULES="!redis,!websocket" - Show all EXCEPT redis and websocket (auto-enables debugging)
# DEBUG_MODULES="orchestrator,!conversation" - Show orchestrator but not conversation (auto-enables debugging)
#
# To avoid OpenAI debug logs, use DEBUG_MODULES instead of DEBUG=true:
# DEBUG_MODULES="!redis"  # Shows everything except redis, without OpenAI logs
DEBUG_MODULES="*"

# Telemetry (optional)
# Set POSTHOG_KEY to your PostHog project API key (phc_...) to enable dashboard
# analytics AND server-side error reporting. Leave unset to disable telemetry
# entirely — no script is loaded in the browser and the server never constructs
# a PostHog client or makes an outbound request.
# POSTHOG_KEY=
# POSTHOG_HOST can be PostHog directly or a reverse proxy (e.g. https://b.hay.chat).
# Used by both the browser and the server, so a proxy here must forward the
# server ingestion paths (/batch, /i/v0/e), not just the browser ones.
# POSTHOG_HOST=https://eu.i.posthog.com

# Conversation options
CONVERSATION_COOLDOWN_INTERVAL=10000 # 10s
CONVERSATION_INACTIVITY_INTERVAL=1800000 # 30min

# SMTP Email Configuration
# Enable/disable SMTP email sending
SMTP_ENABLED=false

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465, false for other ports

# SMTP Authentication
# For Gmail: use your email and an app-specific password
# For SendGrid: use 'apikey' as username and your API key as password
# For AWS SES: use your SMTP credentials
SMTP_AUTH_USER=your-email@gmail.com
SMTP_AUTH_PASS=your-app-specific-password

# Default Sender Information
SMTP_FROM_EMAIL=noreply@updates.hay.chat
SMTP_FROM_NAME=Hay.chat

# Resend (email channel). Full-access API key: the email-channel plugin reads
# received mail with it, and core registers custom sending domains (D13-9).
# A verified domain only changes the From address when SMTP relays through
# Resend (smtp.resend.com). Empty = custom domains are unavailable.
# RESEND_API_KEY=
# Signing secret (whsec_…) of the Resend webhook for email.bounced,
# email.complained and email.delivered → https://<api>/v1/webhooks/email-events
# (D13-10). Separate from RESEND_WEBHOOK_SECRET (inbound mail). Empty = 503.
# RESEND_EVENTS_WEBHOOK_SECRET=

# Common SMTP Providers Configuration Examples:
# 
# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_USER=your-email@gmail.com
# SMTP_AUTH_PASS=your-app-specific-password
#
# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_USER=apikey
# SMTP_AUTH_PASS=your-sendgrid-api-key
#
# AWS SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_USER=your-ses-smtp-username
# SMTP_AUTH_PASS=your-ses-smtp-password
#
# Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_USER=postmaster@your-domain.mailgun.org
# SMTP_AUTH_PASS=your-mailgun-password

# Stripe Configuration (for Cloud Plugin - Billing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter_id
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_id
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_id

# Plugin OAuth Configuration
# OAuth is configured per-plugin using environment variables
# Format: {PLUGIN_ID}_OAUTH_CLIENT_ID and optionally {PLUGIN_ID}_OAUTH_CLIENT_SECRET
#
# For CIMD (Client ID Metadata Document) plugins like Stripe:
#   - Set only the CLIENT_ID to your OAuth redirect URI
#   - CLIENT_SECRET is not needed
#   - Example: STRIPE_OAUTH_CLIENT_ID=https://api.hay.chat/oauth/callback
#
# For traditional OAuth plugins:
#   - Set both CLIENT_ID and CLIENT_SECRET
#   - Example: PLUGIN_OAUTH_CLIENT_ID=your_client_id
#   - Example: PLUGIN_OAUTH_CLIENT_SECRET=your_client_secret
#
# If OAuth env vars are not set, the plugin will use API key authentication instead
# OAuth UI will only appear in the dashboard when the CLIENT_ID is configured
#
# Stripe MCP Plugin OAuth (CIMD - production/managed deployments only)
# Note: Your redirect URI must be allowlisted by Stripe (contact mcp@stripe.com)
# STRIPE_OAUTH_CLIENT_ID=https://api.hay.chat/oauth/callback

# Shopify Plugin OAuth (managed / hay.chat App Store app)
# Used by the Shopify plugin in "managed" authMode. These are hay.chat's own
# Shopify app credentials (Dev Dashboard → API credentials). The plugin substitutes
# the per-merchant {shop} in the authorize/token URLs automatically.
# Add ${API_URL}/oauth/callback to the app's Allowed redirection URL(s) in Shopify.
# SHOPIFY_OAUTH_CLIENT_ID=your_shopify_app_client_id
# SHOPIFY_OAUTH_CLIENT_SECRET=your_shopify_app_client_secret

# "Connect to Hay" handshakes from external apps (e.g. the Shopify embedded app).
# Comma-separated allowlist of origins that (a) /connect/authorize may send an auth
# code to and (b) the plugin OAuth callback may return the user to via
# /integrations/plugins/<id>?connect=1&return_to=<url>. DENY BY DEFAULT.
# CONNECT_ALLOWED_REDIRECT_ORIGINS=https://admin.shopify.com

# Instagram Channel Plugin (shared hay.chat Meta app, Instagram Business Login)
# One Meta app serves every org. Values come from the Meta app dashboard →
# Instagram → API setup with Instagram business login.
# Webhook callback:      ${API_URL}/v1/plugins/hay-channel-instagram-meta/webhook
# Deauthorize callback:  ${API_URL}/v1/plugins/hay-channel-instagram-meta/deauthorize
# Data deletion request: ${API_URL}/v1/plugins/hay-channel-instagram-meta/data-deletion
# META_APP_ID=your_instagram_app_id
# META_APP_SECRET=your_instagram_app_secret        # signs webhooks + signed_request callbacks
# META_VERIFY_TOKEN=any_random_string              # must match the webhook "Verify token" field

# WhatsApp Channel Plugin (Meta Cloud API, Embedded Signup as Tech Provider)
# Uses the Meta app itself (App settings → Basic), NOT the Instagram app id/secret
# above — Instagram Business Login has its own app id/secret, and WhatsApp
# webhooks + Embedded Signup codes are signed/issued for the Meta app.
# Webhook callback:      ${API_URL}/v1/plugins/hay-channel-whatsapp-meta/webhook (verify token: META_VERIFY_TOKEN)
# META_WHATSAPP_APP_ID=your_meta_app_id
# META_WHATSAPP_APP_SECRET=your_meta_app_secret     # signs webhooks + exchanges Embedded Signup codes
# META_WHATSAPP_ES_CONFIG_ID=your_embedded_signup_config_id

# Messenger Channel Plugin (Facebook Login + Messenger Platform, shared Meta app)
# Uses the Meta app itself (App settings → Basic), usually the same values as
# META_WHATSAPP_APP_ID / META_WHATSAPP_APP_SECRET. Webhook object "Page", fields
# messages + message_echoes. Valid OAuth redirect URI: ${API_URL}/oauth/callback.
# Webhook callback:      ${API_URL}/v1/plugins/hay-channel-messenger-meta/webhook (verify token: META_VERIFY_TOKEN)
# Deauthorize callback:  ${API_URL}/v1/plugins/hay-channel-messenger-meta/deauthorize
# Data deletion request: ${API_URL}/v1/plugins/hay-channel-messenger-meta/data-deletion
# META_MESSENGER_APP_ID=your_meta_app_id
# META_MESSENGER_APP_SECRET=your_meta_app_secret    # signs webhooks + signed_request callbacks

# Bot protection plugin (plugins/core/turnstile, Cloudflare Turnstile)
# One Hay.chat-owned key pair serves every org. Unset = no challenge is served
# (the feature is unavailable and a log line says so).
# Local/staging: Cloudflare's published TEST keys. 1x… always passes, 2x… always fails.
# Never commit real keys. Add the API domain to the Turnstile widget's hostnames.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Webchat under-attack mode (D9-10): when one org gets more than
# UNDER_ATTACK_CREATE_THRESHOLD new webchat conversations within 5 minutes,
# every visitor is challenged for UNDER_ATTACK_HOURS. 0 disables the auto
# trigger (owners can still switch it on in Settings > Webchat).
# UNDER_ATTACK_CREATE_THRESHOLD=30
# UNDER_ATTACK_HOURS=4
