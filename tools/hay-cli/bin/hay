#!/usr/bin/env bash
# Runs the hay CLI with the monorepo's tsx. Symlink it onto PATH, e.g.
#   ln -s /srv/hay-core/repo/tools/hay-cli/bin/hay ~/.local/bin/hay
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
repo="$(cd "$here/../../.." && pwd)"
# tsx is a server dependency; npm hoists it to the root only sometimes.
for tsx in "$repo/node_modules/.bin/tsx" "$repo/server/node_modules/.bin/tsx"; do
  [ -x "$tsx" ] && exec "$tsx" "$here/../src/main.ts" "$@"
done
echo "hay: tsx not found; run npm install in $repo" >&2
exit 1
