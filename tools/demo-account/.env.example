# Casa Aurora demo seed: copy to tools/demo-account/.env (gitignored) and fill what you use.
# `hay demo seed all` runs every store whose keys are set and skips the rest.
# Never put production merchant credentials here: test stores only.

# --- Hay.chat (login comes from the hay CLI: tools/hay-cli/.env HAY_EMAIL / HAY_PASSWORD, or `hay login`)
# The org each demo store is connected to. `--org <id>` overrides for a single run.
HAY_ORG_SHOPIFY=
HAY_ORG_WOOCOMMERCE=
HAY_ORG_NUVEMSHOP=

# --- Shopify development store (custom app → Admin API access token)
SHOPIFY_STORE_DOMAIN=haychat-2.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# --- WooCommerce (wp-admin → WooCommerce → Settings → Advanced → REST API, Read/Write)
WOO_URL=http://localhost:8085
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# Optional: upload images through the WordPress media API instead of a public image URL
WP_USER=
WP_APP_PASSWORD=

# --- Nuvemshop (store id + access token with products/orders/customers write scopes)
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
