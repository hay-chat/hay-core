{
  "name": "@hay/webchat",
  "version": "0.1.0",
  "description": "Hay Webchat Widget - Vue 3 chat widget for customer support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.loader.config.ts",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:perf": "node scripts/check-perf.mjs",
    "perf:lighthouse": "node scripts/perf/lighthouse.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^24.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.6"
  }
}
